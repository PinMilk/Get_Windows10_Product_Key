# TypeScript가 소스 옆에 생성하는 JavaScript (직접 작성한 다른 .js 파일은 추적 가능)
/productKey.js

# TypeScript 소스 맵과 증분 빌드 캐시
*.js.map
*.tsbuildinfo

# npm으로 설치한 의존성 (package.json과 package-lock.json은 추적)
node_modules/

# 별도 출력 디렉터리로 빌드할 때 생성되는 결과물
/.build/
/build/

# C 컴파일로 생성되는 확장자 없는 실행 파일 (저장소 루트)
/productKey

# Windows 실행 파일과 컴파일러 기본 출력 파일
*.exe
*.out

# C 컴파일 중 생성되는 오브젝트 파일 (Unix 계열 / Windows)
*.o
*.obj

# macOS 디버그 심볼 번들 (디렉터리 규칙 하나로 내부 파일도 모두 제외)
*.dSYM/

# MSVC의 디버그 정보, 증분 링크 정보 및 컴파일러 상태 파일
*.pdb
*.ilk
*.idb

# 빌드·실행·npm 작업 중 생성되는 로그
*.log

# macOS Finder와 Windows 탐색기가 자동 생성하는 메타데이터
.DS_Store
Thumbs.db
