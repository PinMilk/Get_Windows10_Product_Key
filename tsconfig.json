{
  "compilerOptions": {
    // 현대 Node.js에서 지원하는 ES2022 문법으로 출력해 불필요한 하위 버전 변환을 줄입니다.
    "target": "ES2022",

    // Node.js의 실제 모듈 규칙을 따릅니다. 현재 package.json에 type이 없으므로 CommonJS로 출력합니다.
    // moduleResolution과 esModuleInterop은 NodeNext에 맞게 자동 설정되므로 따로 지정하지 않습니다.
    "module": "NodeNext",

    // 브라우저 DOM 타입은 제외하고 ES2022 표준 API만 포함합니다.
    "lib": ["ES2022"],

    // child_process, process 등 Node.js API의 타입을 명시적으로 불러옵니다.
    "types": ["node"],

    // 암시적 any, null/undefined 처리 등 엄격한 타입 검사를 활성화합니다.
    "strict": true,

    // 외부 선언 파일의 내부 검사는 생략해 검사 시간을 줄입니다. 소스 코드 타입 검사는 유지합니다.
    "skipLibCheck": true,

    // 타입 오류가 있으면 JavaScript를 생성하지 않아 잘못된 빌드 결과를 방지합니다.
    "noEmitOnError": true,

    // 운영체제별 파일 시스템의 대소문자 처리 차이로 생기는 import 오류를 방지합니다.
    "forceConsistentCasingInFileNames": true
  },

  // 실제 프로그램만 컴파일합니다. 출력 경로를 지정하지 않아 productKey.js는 소스 옆에 생성됩니다.
  "include": ["productKey.ts"]
}
